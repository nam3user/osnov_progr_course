"""
ДЗ презентации 4, базовый уровень, задача 2.
Время: 15–20 минут.

Тема: арифметика, форматирование.

Условие:
    Даны длина 12 и ширина 5 прямоугольника.
    Выведите площадь и периметр.
"""

def main():
    length = 12
    width = 5
    area = length * width
    perimeter = 2 * (length + width)
    print(f"Площадь: {area}")
    print(f"Периметр: {perimeter}")




"""
ДЗ презентации 4, базовый уровень, задача 1.
Время: 15–20 минут.

Тема: ввод/вывод, str, int.

Условие:
    Запросите имя, возраст и город.
    Выведите: Иван, 25 лет, Москва.
"""

def main():
    name = input("Имя: ")
    age = int(input("Возраст: "))
    city = input("Город: ")
    print(f"{name}, {age} лет, {city}")


if __name__ == "__main__":
    main()
