"""
ДЗ презентации 2, базовый уровень, задача 1.
Время: 15–20 минут.

Тема: переменные, присваивание, print.

Условие:
    Создайте переменные name = "Иван", age = 25, city = "Москва".
    Выведите строку: Иван, 25 лет, Москва.
"""

def main():
    name = "Иван"
    age = 25
    city = "Москва"
    print(f"{name}, {age} лет, {city}")


"""
ДЗ презентации 2, базовый уровень, задача 2.
Время: 15–20 минут.

Тема: арифметические операторы.

Условие:
    Даны числа a = 7 и b = 3.
    Выведите их сумму, разность, произведение, частное,
    целочисленное деление, остаток и возведение в степень.
"""

def main():
    a = 7
    b = 3
    print(f"Сумма: {a + b}")
    print(f"Разность: {a - b}")
    print(f"Произведение: {a * b}")
    print(f"Частное: {a / b}")
    print(f"Целочисленное деление: {a // b}")
    print(f"Остаток: {a % b}")
    print(f"Степень: {a ** b}")


if __name__ == "__main__":
    main()
